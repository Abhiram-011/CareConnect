{
  "name": "careconnect",
  "version": "1.0.0",
  "description": "CareConnect - Platform Connecting Donors, Volunteers and Old-Age Homes",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "start": "npm --prefix server run start",
    "build": "npm --prefix client run build",
    "test:module1": "npm --prefix server run test:module1",
    "test:module2": "npm --prefix server run test:module2",
    "test:module3": "npm --prefix server run test:module3",
    "test:module4": "npm --prefix server run test:module4",
    "test": "npm --prefix server run test:all",
    "test:all": "npm --prefix server run test:all"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
